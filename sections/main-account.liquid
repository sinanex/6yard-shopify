{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer-account-wrapper page-width">
  <!-- Branded Customer App Bar -->
  <div class="customer-appbar">
    <div class="customer-appbar__brand">
      <a href="{{ routes.root_url }}" aria-label="6YARD Home">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="6YARD Football Kits"
          class="customer-appbar__logo"
          width="130"
          height="42"
          loading="eager"
        >
      </a>
      <span class="customer-appbar__badge">OFFICIAL STORE</span>
    </div>
    <div class="customer-appbar__actions">
      <a href="{{ routes.all_products_collection_url }}" class="customer-appbar__shop-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span>Shop Kits</span>
      </a>
      <a href="{{ routes.account_logout_url }}" class="customer-appbar__logout-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        <span>Sign Out</span>
      </a>
    </div>
  </div>

  <!-- Profile Hero Header -->
  <div class="customer-profile-hero">
    <div class="customer-profile-hero__main">
      <div class="customer-avatar">
        <span>{{ customer.first_name | slice: 0, 1 | default: 'U' | upcase }}</span>
      </div>
      <div class="customer-profile-info">
        <h1 class="customer-profile-name">{{ customer.name | default: 'Football Fan' }}</h1>
        <p class="customer-profile-meta">
          {%- if customer.email != blank -%}
            <span class="customer-meta-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              {{ customer.email }}
            </span>
          {%- endif -%}
          {%- if customer.phone != blank or customer.default_address.phone != blank -%}
            <span class="customer-meta-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              {{ customer.phone | default: customer.default_address.phone }}
            </span>
          {%- endif -%}
        </p>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="customer-profile-stats">
      <div class="customer-stat-box">
        <span class="customer-stat-value">{{ customer.orders_count }}</span>
        <span class="customer-stat-label">Total Orders</span>
      </div>
      <div class="customer-stat-box">
        <span class="customer-stat-value">{{ customer.total_spent | money }}</span>
        <span class="customer-stat-label">Total Spent</span>
      </div>
      <div class="customer-stat-box">
        <span class="customer-stat-value">{{ customer.addresses_count }}</span>
        <span class="customer-stat-label">Addresses</span>
      </div>
    </div>
  </div>

  <!-- Dashboard Navigation Grid -->
  <div class="customer-dashboard-grid">
    <!-- Left Column: Orders History -->
    <div class="customer-orders-section">
      <div class="section-card-header">
        <h2 class="section-card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          Order History & Tracking
        </h2>
        <span class="section-card-tag">{{ customer.orders_count }} Orders Placed</span>
      </div>

      {%- paginate customer.orders by 10 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="customer-orders-list">
            {%- for order in customer.orders -%}
              <div class="customer-order-card">
                <div class="customer-order-card__header">
                  <div>
                    <span class="order-number">Order {{ order.name }}</span>
                    <span class="order-date">{{ order.created_at | time_tag: format: 'date' }}</span>
                  </div>
                  <div class="order-badges">
                    <span class="order-badge order-badge--{{ order.financial_status }}">
                      {{ order.financial_status_label }}
                    </span>
                    <span class="order-badge order-badge--{{ order.fulfillment_status }}">
                      {{ order.fulfillment_status_label }}
                    </span>
                  </div>
                </div>

                <!-- Order Items Preview -->
                <div class="customer-order-card__items">
                  {%- for line_item in order.line_items -%}
                    <div class="order-item-row">
                      {%- if line_item.image -%}
                        <img
                          src="{{ line_item.image | image_url: width: 100 }}"
                          alt="{{ line_item.title }}"
                          class="order-item-thumb"
                          width="50"
                          height="50"
                        >
                      {%- else -%}
                        <div class="order-item-thumb order-item-thumb--placeholder">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        </div>
                      {%- endif -%}
                      <div class="order-item-meta">
                        <span class="order-item-title">{{ line_item.product.title }}</span>
                        <span class="order-item-variant">Size: {{ line_item.variant.title }} • Qty: {{ line_item.quantity }}</span>
                      </div>
                      <span class="order-item-price">{{ line_item.final_line_price | money }}</span>
                    </div>
                  {%- endfor -%}
                </div>

                <!-- Order Card Footer & Tracking -->
                <div class="customer-order-card__footer">
                  <div class="order-total-info">
                    <span class="total-label">Total Amount:</span>
                    <span class="total-amount">{{ order.total_net_amount | money_with_currency }}</span>
                  </div>
                  <div class="order-actions">
                    <a href="{{ order.customer_url }}" class="order-btn-view">View Details</a>
                    {%- assign fulfillment = order.line_items.first.fulfillment -%}
                    {%- if fulfillment.tracking_url != blank -%}
                      <a href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener" class="order-btn-track">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Speed Post Tracking
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="customer-pagination">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="customer-empty-state">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <h3>No Orders Placed Yet</h3>
            <p>Your kit order history and real-time Speed Post tracking will appear here.</p>
            <a href="{{ routes.all_products_collection_url }}" class="customer-empty-cta">Explore Football Kits ➔</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <!-- Right Column: Address & Quick Support -->
    <div class="customer-sidebar-section">
      <!-- Default Delivery Address -->
      <div class="section-card">
        <div class="section-card-header">
          <h2 class="section-card-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Delivery Address
          </h2>
          <a href="{{ routes.account_addresses_url }}" class="section-card-action">Manage ({{ customer.addresses_count }})</a>
        </div>
        <div class="section-card-body">
          {%- if customer.default_address != blank -%}
            <div class="address-preview">
              <span class="address-badge">Primary Delivery Location</span>
              <p class="address-name">{{ customer.default_address.name }}</p>
              <p class="address-lines">
                {{ customer.default_address.address1 }}
                {%- if customer.default_address.address2 != blank %}, {{ customer.default_address.address2 }}{% endif -%}<br>
                {{ customer.default_address.city }}, {{ customer.default_address.province }} - {{ customer.default_address.zip }}<br>
                {{ customer.default_address.country }}
              </p>
              {%- if customer.default_address.phone != blank -%}
                <p class="address-phone">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  {{ customer.default_address.phone }}
                </p>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="text-muted">No address saved yet. Addresses are automatically saved upon your first order.</p>
            <a href="{{ routes.account_addresses_url }}" class="btn-link-action">+ Add New Address</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Quick Support Card -->
      <div class="section-card customer-support-card">
        <h3 class="support-title">Need Order Support?</h3>
        <p class="support-desc">Have a question regarding your jersey size, dispatch date, or Speed Post tracking?</p>
        <a
          href="https://wa.me/919292007150?text=Hi%206YARD!%20I%20have%20an%20inquiry%20regarding%20my%20account%20and%20orders."
          target="_blank"
          rel="noopener"
          class="support-wa-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Chat on WhatsApp Support
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
