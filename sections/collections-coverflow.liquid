<section class="coverflow-section" id="CollectionsCoverflow-{{ section.id }}">
  <div class="coverflow-heading-wrap">
    <h2 class="coverflow-heading">{{ section.settings.heading | default: 'COLLECTIONS' }}</h2>
    <div class="coverflow-underline"></div>
    {%- if section.settings.subheading != blank -%}
      <p class="coverflow-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    assign custom_blocks_count = 0
    for block in section.blocks
      if block.settings.collection != blank
        assign custom_blocks_count = custom_blocks_count | plus: 1
      endif
    endfor
  -%}

  {%- if section.settings.layout_type == 'grid' -%}
    <!-- CLEAN RESPONSIVE CATEGORY GRID -->
    <div class="collections-grid-wrapper">
      <div class="collections-modern-grid">
        {%- if custom_blocks_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign col = block.settings.collection -%}
            {%- if col != blank -%}
              {%- assign col_image = block.settings.custom_image | default: col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <a href="{{ col.url }}" class="collection-modern-card" {{ block.shopify_attributes }}>
                <div class="collection-card-media">
                  {%- if col_image != blank -%}
                    {{ col_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'col-img', widths: '400, 600, 800', alt: col.title | escape }}
                  {%- else -%}
                    <div class="col-placeholder"></div>
                  {%- endif -%}
                  <div class="col-card-overlay"></div>
                </div>
                <div class="col-card-info">
                  <span class="col-product-count">{{ col.all_products_count }} KITS</span>
                  <h3 class="col-card-title">{{ block.settings.title | default: col.title }}</h3>
                  <span class="col-card-link">EXPLORE &rarr;</span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for col in collections -%}
            {%- unless col.handle == 'frontpage' -%}
              {%- assign col_image = col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <a href="{{ col.url }}" class="collection-modern-card">
                <div class="collection-card-media">
                  {%- if col_image != blank -%}
                    {{ col_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'col-img', widths: '400, 600, 800', alt: col.title | escape }}
                  {%- else -%}
                    <div class="col-placeholder"></div>
                  {%- endif -%}
                  <div class="col-card-overlay"></div>
                </div>
                <div class="col-card-info">
                  <span class="col-product-count">{{ col.all_products_count }} KITS</span>
                  <h3 class="col-card-title">{{ col.title }}</h3>
                  <span class="col-card-link">EXPLORE &rarr;</span>
                </div>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    <!-- 3D COVERFLOW SLIDER -->
    <div class="coverflow-container">
      <button type="button" class="coverflow-arrow prev-btn" aria-label="Previous Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="coverflow-arrow next-btn" aria-label="Next Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="coverflow-stage">
        {%- if custom_blocks_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign col = block.settings.collection -%}
            {%- if col != blank -%}
              {%- assign col_image = block.settings.custom_image | default: col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <div class="coverflow-slide {% if forloop.first %}active{% elsif forloop.index == 2 %}next{% elsif forloop.last and forloop.length > 2 %}prev{% else %}hidden-slide{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 1400 | image_tag:
                    loading: 'lazy',
                    class: 'coverflow-slide-img',
                    widths: '550, 750, 1100, 1400',
                    alt: col.title | escape
                  }}
                {%- else -%}
                  <div class="coverflow-slide-img col-placeholder"></div>
                {%- endif -%}

                <div class="coverflow-overlay"></div>

                <div class="coverflow-content">
                  <div class="coverflow-badge">{{ col.all_products_count }} PRODUCTS</div>
                  <h3 class="coverflow-title">{{ block.settings.title | default: col.title }}</h3>
                  <a href="{{ col.url }}" class="coverflow-btn">
                    EXPLORE &rarr;
                  </a>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign slide_idx = 0 -%}
          {%- for col in collections -%}
            {%- unless col.handle == 'frontpage' -%}
              {%- assign col_image = col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <div class="coverflow-slide {% if slide_idx == 0 %}active{% elsif slide_idx == 1 %}next{% else %}hidden-slide{% endif %}" data-index="{{ slide_idx }}">
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 1400 | image_tag:
                    loading: 'lazy',
                    class: 'coverflow-slide-img',
                    widths: '550, 750, 1100, 1400',
                    alt: col.title | escape
                  }}
                {%- else -%}
                  <div class="coverflow-slide-img col-placeholder"></div>
                {%- endif -%}

                <div class="coverflow-overlay"></div>

                <div class="coverflow-content">
                  <div class="coverflow-badge">{{ col.all_products_count }} PRODUCTS</div>
                  <h3 class="coverflow-title">{{ col.title }}</h3>
                  <a href="{{ col.url }}" class="coverflow-btn">
                    EXPLORE &rarr;
                  </a>
                </div>
              </div>
              {%- assign slide_idx = slide_idx | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- OPTIONAL SECONDARY PROMO GRID (Default Disabled to Avoid Duplicate Categories) -->
    {%- if section.settings.show_secondary_grid -%}
      <div class="coverflow-promo-grid">
        {%- for col in collections offset: 1 limit: 4 -%}
          {%- unless col.handle == 'frontpage' -%}
            {%- assign col_image = col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
            <a href="{{ col.url }}" class="coverflow-promo-card">
              {%- if col_image != blank -%}
                {{ col_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: col.title | escape }}
              {%- else -%}
                <div class="col-placeholder"></div>
              {%- endif -%}
              <div class="coverflow-promo-overlay"></div>
              <div class="coverflow-promo-content">
                <h3 class="coverflow-promo-title">{{ col.title }}</h3>
                <span class="coverflow-btn">EXPLORE &rarr;</span>
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collections Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED COLLECTIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore by category, club, sleeve type and national kits"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Category Layout Style",
      "options": [
        { "value": "slider", "label": "3D Sliding Carousel" },
        { "value": "grid", "label": "Modern Responsive Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_grid",
      "label": "Show Secondary 2x2 Grid Below Slider (Optional)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Shopify Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override (optional)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Banner Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Showcase",
      "settings": {
        "heading": "FEATURED COLLECTIONS",
        "layout_type": "slider",
        "show_secondary_grid": false
      }
    }
  ]
}
{% endschema %}
