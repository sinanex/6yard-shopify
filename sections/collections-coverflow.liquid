<section class="coverflow-section" id="CollectionsCoverflow-{{ section.id }}">
  <div class="coverflow-heading-wrap">
    <h2 class="coverflow-heading">{{ section.settings.heading | default: 'COLLECTIONS' }}</h2>
    <div class="coverflow-underline"></div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <!-- 3D COVERFLOW LAYERED CAROUSEL (Top Collections) -->
    <div class="coverflow-container">
      <button type="button" class="coverflow-arrow prev-btn" aria-label="Previous Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="coverflow-arrow next-btn" aria-label="Next Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="coverflow-stage">
        {%- for block in section.blocks limit: 5 -%}
          {%- assign collection = block.settings.collection -%}
          {%- if collection == blank -%}
            {%- assign col_handle = block.settings.title | handleize -%}
            {%- assign collection = collections[col_handle] -%}
          {%- endif -%}
          {%- assign col_image = block.settings.custom_image | default: collection.featured_image | default: collection.image | default: collection.products.first.featured_media.preview_image -%}
          <div class="coverflow-slide {% if forloop.first %}active{% elsif forloop.index == 2 %}next{% elsif forloop.last and section.blocks.size > 2 %}prev{% else %}hidden-slide{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if col_image != blank -%}
              {{ col_image | image_url: width: 1400 | image_tag:
                loading: 'lazy',
                class: 'coverflow-slide-img',
                widths: '550, 750, 1100, 1400',
                alt: block.settings.title | default: collection.title | escape
              }}
            {%- else -%}
              <div class="coverflow-slide-img" style="background: linear-gradient(135deg, #111827 0%, #030712 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            <div class="coverflow-overlay"></div>

            <div class="coverflow-content">
              <div class="coverflow-badge">FEATURED COLLECTION</div>
              <h3 class="coverflow-title">{{ block.settings.title | default: collection.title | default: 'Football Collection' }}</h3>
              <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="coverflow-btn">
                EXPLORE &rarr;
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- 2x2 PROMO GRID FOR OTHER COLLECTIONS -->
    {%- if section.blocks.size > 1 -%}
      <div class="coverflow-promo-grid">
        {%- for block in section.blocks offset: 1 limit: 4 -%}
          {%- assign collection = block.settings.collection -%}
          {%- if collection == blank -%}
            {%- assign col_handle = block.settings.title | handleize -%}
            {%- assign collection = collections[col_handle] -%}
          {%- endif -%}
          {%- assign col_image = block.settings.custom_image | default: collection.featured_image | default: collection.image | default: collection.products.first.featured_media.preview_image -%}
          <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="coverflow-promo-card" {{ block.shopify_attributes }}>
            {%- if col_image != blank -%}
              {{ col_image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 900',
                alt: block.settings.title | default: collection.title | escape
              }}
            {%- else -%}
              <div style="background: linear-gradient(135deg, #1f2937 0%, #111827 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            <div class="coverflow-promo-overlay"></div>

            <div class="coverflow-promo-content">
              <h3 class="coverflow-promo-title">{{ block.settings.title | default: collection.title | default: 'Club Editions' }}</h3>
              <span class="coverflow-btn">
                EXPLORE &rarr;
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collections Coverflow",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTIONS"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override (optional)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Banner Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Coverflow",
      "blocks": [
        { "type": "collection_item", "settings": { "title": "RETRO CLASSICS" } },
        { "type": "collection_item", "settings": { "title": "CLUB EDITIONS 24/25" } },
        { "type": "collection_item", "settings": { "title": "NATIONAL TEAMS" } },
        { "type": "collection_item", "settings": { "title": "FIVE SLEEVE SPECIALS" } },
        { "type": "collection_item", "settings": { "title": "FULL SLEEVE JERSEYS" } }
      ]
    }
  ]
}
{% endschema %}
