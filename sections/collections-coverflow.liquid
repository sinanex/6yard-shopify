<section class="coverflow-section" id="category-section" data-section-id="{{ section.id }}">
  <span id="CollectionsCoverflow-{{ section.id }}" style="display:none;" aria-hidden="true"></span>
  
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="coverflow-heading-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="coverflow-heading">{{ section.settings.heading }}</h2>
        <div class="coverflow-underline"></div>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="coverflow-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign show_carousel = false
    assign show_grid = false

    if section.settings.layout_type == 'both'
      assign show_carousel = true
      assign show_grid = true
    elsif section.settings.layout_type == 'grid'
      assign show_grid = true
    elsif section.settings.layout_type == 'slider'
      assign show_carousel = true
      if section.settings.show_grid_below
        assign show_grid = true
      endif
    else
      assign show_carousel = true
      assign show_grid = true
    endif

    assign custom_blocks_count = 0
    for block in section.blocks
      if block.settings.collection != blank
        assign custom_blocks_count = custom_blocks_count | plus: 1
      endif
    endfor
  -%}

  {%- if show_carousel -%}
    <!-- 3D COVERFLOW SLIDER -->
    <div class="coverflow-container">
      <button type="button" class="coverflow-arrow prev-btn" aria-label="Previous Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="coverflow-arrow next-btn" aria-label="Next Collection">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="coverflow-stage">
        {%- if custom_blocks_count > 0 -%}
          {%- assign carousel_slide_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign col = block.settings.collection -%}
            {%- if col != blank and block.settings.show_in_carousel != false -%}
              {%- assign col_image = block.settings.custom_image | default: col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              {%- assign card_link = block.settings.custom_link | default: col.url -%}
              <div class="coverflow-slide {% if carousel_slide_idx == 0 %}active{% elsif carousel_slide_idx == 1 %}next{% else %}hidden-slide{% endif %}" data-index="{{ carousel_slide_idx }}" {{ block.shopify_attributes }}>
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 1400 | image_tag:
                    loading: 'lazy',
                    class: 'coverflow-slide-img',
                    widths: '550, 750, 1100, 1400',
                    alt: block.settings.title | default: col.title | escape
                  }}
                {%- else -%}
                  <div class="coverflow-slide-img col-placeholder"></div>
                {%- endif -%}

                <div class="coverflow-overlay"></div>

                <div class="coverflow-content">
                  <div class="coverflow-badge">{{ col.all_products_count }} PRODUCTS</div>
                  <h3 class="coverflow-title">{{ block.settings.title | default: col.title }}</h3>
                  <a href="{{ card_link }}" class="coverflow-btn">
                    EXPLORE &rarr;
                  </a>
                </div>
              </div>
              {%- assign carousel_slide_idx = carousel_slide_idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign slide_idx = 0 -%}
          {%- for col in collections -%}
            {%- unless col.handle == 'frontpage' -%}
              {%- assign col_image = col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <div class="coverflow-slide {% if slide_idx == 0 %}active{% elsif slide_idx == 1 %}next{% else %}hidden-slide{% endif %}" data-index="{{ slide_idx }}">
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 1400 | image_tag:
                    loading: 'lazy',
                    class: 'coverflow-slide-img',
                    widths: '550, 750, 1100, 1400',
                    alt: col.title | escape
                  }}
                {%- else -%}
                  <div class="coverflow-slide-img col-placeholder"></div>
                {%- endif -%}

                <div class="coverflow-overlay"></div>

                <div class="coverflow-content">
                  <div class="coverflow-badge">{{ col.all_products_count }} PRODUCTS</div>
                  <h3 class="coverflow-title">{{ col.title }}</h3>
                  <a href="{{ col.url }}" class="coverflow-btn">
                    EXPLORE &rarr;
                  </a>
                </div>
              </div>
              {%- assign slide_idx = slide_idx | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if show_grid -%}
    <!-- 2-COLUMN CATEGORY BLOCKS GRID (EXACT TO USER DESIGN) -->
    <div class="category-blocks-wrapper">
      {%- if section.settings.grid_heading != blank -%}
        <div class="category-blocks-header">
          <h3 class="category-blocks-title">{{ section.settings.grid_heading }}</h3>
          {%- if section.settings.grid_subheading != blank -%}
            <p class="category-blocks-sub">{{ section.settings.grid_subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="category-blocks-grid category-grid--{{ section.settings.grid_columns_desktop | default: '4' }}-col" style="--cat-card-aspect-ratio: {{ section.settings.grid_card_ratio | default: '4/5' }}; --cat-card-radius: {{ section.settings.grid_card_radius | default: 12 }}px; --cat-img-fit: {{ section.settings.grid_image_fit | default: 'cover' }};">
        {%- if custom_blocks_count > 0 -%}
          {%- assign grid_rendered_count = 0 -%}
          {%- assign grid_limit = section.settings.grid_items_limit | default: 12 -%}
          {%- for block in section.blocks -%}
            {%- assign col = block.settings.collection -%}
            {%- if col != blank and block.settings.show_in_grid != false -%}
              {%- if grid_rendered_count < grid_limit -%}
                {%- assign card_image = block.settings.grid_image | default: block.settings.custom_image | default: col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
                {%- assign card_title = block.settings.title | default: col.title -%}
                {%- assign card_link = block.settings.custom_link | default: col.url -%}

                <a href="{{ card_link }}" class="category-block-card" {{ block.shopify_attributes }}>
                  <div class="category-block-media">
                    {%- if card_image != blank -%}
                      {{ card_image | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        class: 'category-block-img',
                        widths: '320, 480, 640, 800',
                        alt: card_title | escape
                      }}
                    {%- else -%}
                      <div class="col-placeholder"></div>
                    {%- endif -%}
                  </div>
                  <div class="category-block-info">
                    <h3 class="category-block-title">{{ card_title }}</h3>
                  </div>
                </a>
                {%- assign grid_rendered_count = grid_rendered_count | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for col in collections limit: 8 -%}
            {%- unless col.handle == 'frontpage' -%}
              {%- assign card_image = col.image | default: col.products.first.featured_media.preview_image | default: col.products.first.featured_image -%}
              <a href="{{ col.url }}" class="category-block-card">
                <div class="category-block-media">
                  {%- if card_image != blank -%}
                    {{ card_image | image_url: width: 800 | image_tag:
                      loading: 'lazy',
                      class: 'category-block-img',
                      widths: '320, 480, 640, 800',
                      alt: col.title | escape
                    }}
                  {%- else -%}
                    <div class="col-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="category-block-info">
                  <h3 class="category-block-title">{{ col.title }}</h3>
                </div>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collections Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED COLLECTIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore official kits by category, club and national teams"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Display Mode",
      "options": [
        { "value": "both", "label": "Carousel + Category Blocks (Both)" },
        { "value": "slider", "label": "Carousel Only" },
        { "value": "grid", "label": "Category Blocks Grid Only" }
      ],
      "default": "both"
    },
    {
      "type": "checkbox",
      "id": "show_grid_below",
      "label": "Show Category Blocks Grid Below Carousel",
      "default": true
    },
    {
      "type": "header",
      "content": "Category Blocks Grid Settings"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid Section Heading (optional)"
    },
    {
      "type": "text",
      "id": "grid_subheading",
      "label": "Grid Section Subheading (optional)"
    },
    {
      "type": "select",
      "id": "grid_columns_desktop",
      "label": "Grid Columns (Desktop)",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "grid_card_ratio",
      "label": "Card Image Aspect Ratio / Height",
      "options": [
        { "value": "4/5", "label": "Portrait (4:5) — Reference Design" },
        { "value": "3/4", "label": "Portrait (3:4) — Medium Height" },
        { "value": "2/3", "label": "Portrait (2:3) — Extra Tall" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3) — Compact" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "grid_image_fit",
      "label": "Image Fit Style",
      "options": [
        { "value": "cover", "label": "Cover (Fills entire card cleanly)" },
        { "value": "contain", "label": "Contain (Fits full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "grid_card_radius",
      "label": "Card Corner Roundness",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "grid_items_limit",
      "label": "Max Blocks in Grid",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Shopify Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override (optional)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Banner / Carousel Image (optional)"
        },
        {
          "type": "image_picker",
          "id": "grid_image",
          "label": "Custom Grid Block Image (optional portrait crop)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_in_carousel",
          "label": "Show in Carousel",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_in_grid",
          "label": "Show in Blocks Grid",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Showcase",
      "settings": {
        "heading": "FEATURED COLLECTIONS",
        "layout_type": "both",
        "show_grid_below": true
      }
    }
  ]
}
{% endschema %}
