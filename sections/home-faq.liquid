{%- style -%}
  .home-faq-section-{{ section.id }} {
    padding: 60px 0 80px;
    background-color: #ffffff;
  }

  .home-faq-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media screen and (min-width: 750px) {
    .home-faq-container {
      padding: 0 32px;
    }
  }

  .home-faq-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .home-faq-title {
    font-family: var(--font-h);
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 900;
    text-transform: uppercase;
    color: #030712;
    margin: 0 0 8px 0;
    letter-spacing: -0.02em;
  }

  .home-faq-subtitle {
    font-size: 14px;
    color: #6b7280;
    margin: 0;
  }

  .home-faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e5e7eb;
  }

  .home-faq-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .home-faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    gap: 16px;
  }

  .home-faq-question {
    font-family: var(--font-h);
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    margin: 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .home-faq-trigger:hover .home-faq-question {
    color: #4b5563;
  }

  .home-faq-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #111827;
    transition: transform 0.25s ease;
  }

  .home-faq-item.is-open .home-faq-icon {
    transform: rotate(180deg);
  }

  .home-faq-answer-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0, 1, 0, 1);
  }

  .home-faq-item.is-open .home-faq-answer-wrap {
    max-height: 500px;
    transition: max-height 0.35s ease-in-out;
  }

  .home-faq-answer {
    padding-bottom: 22px;
    font-size: 14px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }
{%- endstyle -%}

<div class="home-faq-section-{{ section.id }}" id="faq">
  <div class="home-faq-container">

    <div class="home-faq-header">
      <h2 class="home-faq-title">{{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}</h2>
      <p class="home-faq-subtitle">{{ section.settings.subtitle | default: 'Everything you need to know about ordering, delivery, sizing and authenticity.' }}</p>
    </div>

    <div class="home-faq-list">
      {%- for block in section.blocks -%}
        <div class="home-faq-item {% if forloop.first %}is-open{% endif %}" {{ block.shopify_attributes }}>
          <button type="button" class="home-faq-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="home-faq-question">{{ block.settings.question }}</span>
            <span class="home-faq-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="home-faq-answer-wrap">
            <p class="home-faq-answer">{{ block.settings.answer }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqSection = document.getElementById('faq');
    if (!faqSection) return;

    const items = faqSection.querySelectorAll('.home-faq-item');

    items.forEach((item) => {
      const trigger = item.querySelector('.home-faq-trigger');
      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close other items
        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('.home-faq-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Home FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about ordering, delivery, sizing and authenticity."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take across India and how can I track it?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Orders are processed within 2-4 business days. Standard express delivery takes 5-7 business days across India. Once dispatched, you will receive real-time Speed Post tracking details."
        }
      ]
    }
  ],
  "presets": [
