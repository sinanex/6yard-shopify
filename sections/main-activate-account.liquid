{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer-auth-container page-width">
  <div class="customer-auth-card">
    <div class="customer-auth-brand">
      <a href="{{ routes.root_url }}">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="6YARD Football Kits"
          class="customer-auth-logo"
          width="135"
          height="44"
          loading="eager"
        >
      </a>
      <p class="customer-auth-tagline">BUILT TO PLAY • FOOTBALL KITS</p>
    </div>

    <div class="customer-auth-box">
      <h1 class="customer-auth-title">Activate Account</h1>
      <p class="customer-auth-desc">Create your password to activate your 6YARD account.</p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="auth-error-msg">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="auth-field">
          <label for="password">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            placeholder="Minimum 6 characters"
            required
          >
        </div>

        <div class="auth-field">
          <label for="password_confirmation">Confirm Password</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            placeholder="Confirm password"
            required
          >
        </div>

        <button type="submit" class="auth-submit-btn">Activate Account</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activate Account",
  "settings": []
}
{% endschema %}
