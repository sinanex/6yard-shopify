{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer-addresses-page page-width">

  <div class="addresses-header">
    <h1 class="addresses-title">Delivery Addresses</h1>
    <p class="addresses-subtitle">Manage your shipping destinations for fast checkout.</p>
  </div>

  {%- paginate customer.addresses by 6 -%}
    <div class="addresses-grid">
      {%- for address in customer.addresses -%}
        <div class="address-card-item {% if address == customer.default_address %}address-card-item--default{% endif %}">
          {%- if address == customer.default_address -%}
            <span class="default-badge">DEFAULT ADDRESS</span>
          {%- endif -%}
          <p class="addr-person-name">{{ address.name }}</p>
          <p class="addr-details">
            {{ address.address1 }}
            {%- if address.address2 != blank %}, {{ address.address2 }}{% endif -%}<br>
            {{ address.city }}, {{ address.province }} - {{ address.zip }}<br>
            {{ address.country }}
          </p>
          {%- if address.phone != blank -%}
            <p class="addr-phone">Phone: {{ address.phone }}</p>
          {%- endif -%}

          <div class="addr-actions">
            <form
              class="address-delete-form"
              method="post"
              action="/account/addresses/{{ address.id }}"
              onsubmit="return confirm('Delete this address?');"
            >
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn-addr-del">Delete</button>
            </form>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="customer-pagination">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
